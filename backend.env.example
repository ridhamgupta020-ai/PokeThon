# ==========================================
# POKETHON BACKEND ENVIRONMENT VARIABLES
# ==========================================

# Server Port
PORT=3000
NODE_ENV=development

# Supabase PostgreSQL Configuration
# Keep SERVICE_ROLE_KEY confidential on server only.
SUPABASE_URL="https://your-project-id.supabase.co"
SUPABASE_ANON_KEY="your-anon-public-key"
SUPABASE_SERVICE_ROLE_KEY="your-secret-service-role-key"

# Database Connection String (Direct PostgreSQL URI for Drizzle/Prisma/pg)
DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-ID].supabase.co:5432/postgres"

# Admin & Organizer Authorization
ADMIN_ACCESS_KEY="pokethon2026"
JWT_SECRET="generate-a-secure-random-secret-for-production"

# CORS Allowed Origins
ALLOWED_ORIGINS="http://localhost:3000"
